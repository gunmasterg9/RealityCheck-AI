# RealityCheck AI Environment Configuration
REALITYCHECK_ENV=development
HOST=127.0.0.1
PORT=8000

# Provider & Inference Architecture
DEFAULT_PROVIDER_MODE=auto
STAGE_TIMEOUT_SECONDS=90
TOTAL_VERIFICATION_TIMEOUT_SECONDS=300
MAX_LLM_RETRIES=1
INFERENCE_TIMEOUT_SECONDS=90

# Local Inference (Ollama)
# qwen3:1.7b is recommended for low-RAM/CPU laptops; gemma4:e4b for 16GB+ VRAM GPU systems
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_ID=qwen3:1.7b
HEAVY_LOCAL_MODEL_ID=gemma4:e4b
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_THREADS=4

# Cloud Inference (Optional Google Gemini fallback)
# Set your key here to enable cloud provider:
GEMINI_API_KEY=
CLOUD_MODEL_ID=gemini-3.8-flash

# External Fact-Checking & Web Search APIs (Optional)
FACT_CHECK_API_KEY=
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Database & CORS
SQLITE_DB_PATH=realitycheck.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
