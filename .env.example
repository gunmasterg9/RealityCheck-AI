# RealityCheck AI Environment Configuration
REALITYCHECK_ENV=development
HOST=127.0.0.1
PORT=8000

# Local Inference (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_ID=gemma4:e4b
INFERENCE_TIMEOUT_SECONDS=180

# Cloud Inference (Optional Google Gemini fallback)
# Set your key here to enable optional cloud provider:
GEMINI_API_KEY=
CLOUD_MODEL_ID=gemini-2.5-flash

# Database & CORS
SQLITE_DB_PATH=realitycheck.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
